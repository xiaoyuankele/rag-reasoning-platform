{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-reasoning-platform.local/contracts/document-processing/v1/success-response.schema.json",
  "title": "Document Processing Success Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "status",
    "chunks"
  ],
  "properties": {
    "contract_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "status": {
      "const": "succeeded"
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "content"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "page_start": {
            "type": "integer",
            "minimum": 1
          },
          "page_end": {
            "type": "integer",
            "minimum": 1
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "page_start"
              ]
            },
            "then": {
              "required": [
                "page_end"
              ]
            }
          },
          {
            "if": {
              "required": [
                "page_end"
              ]
            },
            "then": {
              "required": [
                "page_start"
              ]
            }
          }
        ]
      }
    }
  }
}
