# Go 后端监听端口，有效范围为 1 到 65535。
APP_PORT=8080

# Compose 把后端容器的 8080 映射到本机该端口；与本机直接 go run 的 APP_PORT 分开。
BACKEND_HOST_PORT=8080

# 日志默认使用 info 级别和 JSON 格式。开发时可切换为 debug/text；
# observability-report 成本汇总必须读取 json 格式日志。
LOG_LEVEL=info
LOG_FORMAT=json

# PostgreSQL 连接配置。
DB_HOST=localhost
DB_PORT=5433
DB_NAME=rag_platform
DB_USER=rag_user
DB_PASSWORD=change_me
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=10

# P6 验证码摘要密钥必须至少 32 字节。请为本地 .env 单独生成随机值，
# 不要直接使用示例文字，也不要提交真实密钥。
VERIFICATION_HMAC_SECRET=

# 默认使用零远程费用的内存 Fake Sender；本地人工注册时可以改为 mailpit。
VERIFICATION_SENDER=fake

# Mailpit 本地 SMTP。直接 go run 使用 127.0.0.1；Compose 后端通过
# VERIFICATION_SMTP_COMPOSE_HOST 使用服务名 mailpit。
VERIFICATION_SMTP_HOST=127.0.0.1
VERIFICATION_SMTP_COMPOSE_HOST=mailpit
VERIFICATION_SMTP_PORT=1025
VERIFICATION_SMTP_FROM_ADDRESS=no-reply@rag.local
VERIFICATION_SMTP_FROM_NAME=RAG Reasoning Platform
VERIFICATION_SMTP_TIMEOUT=5s
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_WEB_HOST_PORT=8025

# 单实例滑动窗口限流：同一远端 IP 每分钟最多 5 次，整个进程最多 100 次。
VERIFICATION_RATE_LIMIT_WINDOW=1m
VERIFICATION_PER_CLIENT_LIMIT=5
VERIFICATION_GLOBAL_LIMIT=100

# P6 注册、登录与 Session。Session 默认保留 7 天；本地 HTTP 开发关闭 Secure，
# 生产 HTTPS 部署必须设置 AUTH_COOKIE_SECURE=true。
AUTH_SESSION_TTL=168h
AUTH_COOKIE_SECURE=false

# 注册和登录使用独立的单实例限流预算，不与验证码发送次数混在一起。
AUTH_RATE_LIMIT_WINDOW=1m
AUTH_PER_CLIENT_LIMIT=10
AUTH_GLOBAL_LIMIT=200

# 应用根目录。开发环境留空时会从当前目录向上自动发现项目根目录；
# 部署环境应填写一个已经存在的绝对路径。
APP_ROOT=

# 本地文档存储配置。相对路径固定以 APP_ROOT 为基准。
STORAGE_ROOT=storage

# Compose 专用的宿主机文件目录。正常运行使用 ./storage；灾难恢复验收后可切换到新的恢复目录。
STORAGE_HOST_PATH=./storage

# 单个上传文件最大为 200 MiB（200 * 1024 * 1024 字节）。
STORAGE_MAX_FILE_SIZE_BYTES=209715200

# 上传槽位覆盖文件流读取、写入存储、数据库记录和补偿清理。
# 全局并发不能小于单用户并发；等待超时后返回可重试的 429 或 503。
UPLOAD_MAX_CONCURRENCY_PER_USER=2
UPLOAD_MAX_CONCURRENCY_GLOBAL=16
UPLOAD_QUEUE_WAIT_TIMEOUT=2s

# Worker 在队列为空或单次处理出错后的等待时间，使用 Go duration 格式。
WORKER_POLL_INTERVAL=2s

# 单份文档处理器允许执行的最长时间，超时后任务进入 failed。
WORKER_PROCESSING_TIMEOUT=5m

# Compose 后端容器 CPU 配额。当前机器实测 2.0 CPU 配合 2/2 并发较合适。
# 该值只控制容器资源上限，不等于 Worker 数量。
BACKEND_CPUS=2.0

# 同一后端实例内并行运行的文档 Worker 数量，允许 1～4。
# 当前本地开发示例使用 2；需要稳定降级时可以改回 1。
DOCUMENT_WORKER_CONCURRENCY=2

# 活动解析任务包括 queued 和 processing。先限制单用户，再限制全系统积压。
# 全局上限不能小于单用户上限。
PROCESSING_MAX_ACTIVE_JOBS_PER_USER=5
PROCESSING_MAX_ACTIVE_JOBS_GLOBAL=40
PROCESSING_MAX_IN_FLIGHT_PER_OWNER=1
PROCESSING_MAX_BORROWED_IN_FLIGHT_PER_OWNER=2
PROCESSING_STARVATION_THRESHOLD=2m

# Go 启动复杂文档处理子进程时使用的 Python 可执行程序。
PYTHON_EXECUTABLE=python

# 包含 rag_ai Python 包的源码目录。相对路径固定以 APP_ROOT 为基准。
PYTHON_SOURCE_ROOT=ai/src
PYTHON_PDF_MAX_FILE_SIZE_BYTES=52428800
PYTHON_PDF_MAX_PAGES=500

# Python 复杂文档处理模式：oneshot 每份文档启动一次进程；pool 复用常驻进程。
# 当前本地开发示例启用 pool；oneshot 保留为稳定降级路径。
# 启用 pool 时，池大小不能小于文档 Worker 数。
PYTHON_PROCESS_MODE=pool
PYTHON_PROCESS_POOL_SIZE=2

# 单个常驻 Python 进程处理指定数量文档后自动退出并在下次请求时重建。
PYTHON_PROCESS_MAX_DOCUMENTS=20

# P4 向量任务与后台 Worker 配置。默认关闭，不会访问远程 API 或产生费用。
EMBEDDING_WORKER_ENABLED=false

# 同一后端实例内并发运行的向量 Worker 数。默认 1 可安全降级，允许 1～4。
EMBEDDING_WORKER_CONCURRENCY=1
EMBEDDING_MAX_ACTIVE_JOBS_PER_USER=100
EMBEDDING_MAX_ACTIVE_JOBS_GLOBAL=500
EMBEDDING_MAX_IN_FLIGHT_PER_OWNER=1
EMBEDDING_MAX_BORROWED_IN_FLIGHT_PER_OWNER=2
EMBEDDING_STARVATION_THRESHOLD=2m

# 全局上限负责兜底；Worker 和 Online 分类上限负责隔离，二者之和不能超过全局值。
# 在线请求等待槽位超时后返回可重试的 503；后台 Worker 继续等待到任务取消。
EMBEDDING_PROVIDER_MAX_CONCURRENCY=4
EMBEDDING_WORKER_PROVIDER_CONCURRENCY=2
EMBEDDING_ONLINE_PROVIDER_CONCURRENCY=2
EMBEDDING_ONLINE_QUEUE_WAIT_TIMEOUT=2s

# P4 在线语义检索开关。启用后，每次检索都会调用远程 Embedding API，可能产生费用。
SEMANTIC_SEARCH_ENABLED=false

# 当前默认使用阿里云百炼；以后切回 OpenAI 时只需改为 openai。
EMBEDDING_PROVIDER=dashscope

# 仅当 Worker 或语义检索启用时必填。真实密钥只能写入被 Git 忽略的 .env。
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings

# 留空时按提供方选择默认值：DashScope 使用 text-embedding-v4 和批量 10，
# OpenAI 使用 text-embedding-3-small 和批量 32。只有明确需要覆盖默认值时才填写。
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=
EMBEDDING_HTTP_TIMEOUT=30s
EMBEDDING_PROCESSING_TIMEOUT=5m
EMBEDDING_POLL_INTERVAL=2s
EMBEDDING_MAX_ATTEMPTS=5
EMBEDDING_RETRY_BASE_DELAY=5s
EMBEDDING_RETRY_MAX_DELAY=2m

# P4 带来源问答。默认关闭；启用后每次 POST /answers 都会产生远程模型调用。
ANSWER_ENABLED=false
# 同一后端进程最多同时执行 2 条完整问答链路；超出容量最多等待 3 秒。
ANSWER_MAX_CONCURRENCY=2
ANSWER_QUEUE_WAIT_TIMEOUT=3s

# 第一版使用百炼 OpenAI 兼容 Chat Completions，不开启联网搜索。
# API Key 复用上面的 DASHSCOPE_API_KEY，本字段只配置生成接口地址与生成模型。
DASHSCOPE_GENERATION_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
GENERATION_MODEL=qwen3.6-flash
GENERATION_HTTP_TIMEOUT=60s
GENERATION_MAX_OUTPUT_TOKENS=1024
GENERATION_TEMPERATURE=0.1
GENERATION_THINKING_ENABLED=false
