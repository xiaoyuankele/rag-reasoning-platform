# Go 后端监听端口，有效范围为 1 到 65535。
APP_PORT=8080

# PostgreSQL 连接配置。
DB_HOST=localhost
DB_PORT=5433
DB_NAME=rag_platform
DB_USER=rag_user
DB_PASSWORD=change_me
DB_SSLMODE=disable

# 本地文档存储配置。默认路径以 backend 目录为当前工作目录。
STORAGE_ROOT=../storage

# 单个上传文件最大为 200 MiB（200 * 1024 * 1024 字节）。
STORAGE_MAX_FILE_SIZE_BYTES=209715200
